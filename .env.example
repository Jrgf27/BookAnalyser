# Copy to .env and fill in real values:
#   cp env.example .env

# ---------- Azure OpenAI ----------
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Deployment names (must match your Azure portal)
AZURE_CHAT_DEPLOYMENT=gpt-5.1-chat
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_EMBEDDING_API_VERSION=2024-12-01-preview
EMBEDDING_DIMENSIONS=3072

# ---------- App ----------
DATABASE_PATH=data/books.db
SESSIONS_DATABASE_PATH=data/sessions.db
RAW_DATA_DIR=data/raw
LOG_LEVEL=INFO

# ---------- Ingestion ----------
EMBEDDING_BATCH_SIZE=64
CHUNK_TARGET_TOKENS=600
CHUNK_OVERLAP_FRACTION=0.15
SUMMARIZE_CONCURRENCY=4

# ---------- Agent ----------
AGENT_MAX_ROUNDS=5
CONTEXT_BUDGET_CHARS=12000
# Sampling temperature. Leave unset for gpt-5.1-chat, which only accepts the
# model default (1) and rejects any other value. Set it only for a deployment
# that supports custom temperatures.
# CHAT_TEMPERATURE=0.3
